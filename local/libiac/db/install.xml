<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/libiac/db" VERSION="2026100400" COMMENT="XMLDB file for Moodle local/libiac"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_libiac_user_ctx" COMMENT="Initial interview and last conversation context per user">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user id"/>
        <FIELD NAME="initial_interview" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON or text with the first interview data"/>
        <FIELD NAME="last_context" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON or text with the last conversation context"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign-unique" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
